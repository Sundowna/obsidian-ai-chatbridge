{
	"manifest_version": 3,
	"name": "ChatBridge Browser link (Stage 0 spike)",
	"version": "0.0.1",
	"description": "Throwaway test build. Proves the Browser link works in a real browser. Not for daily use.",
	"minimum_chrome_version": "116",
	"background": { "service_worker": "background.js", "type": "module" },
	"options_page": "options.html",
	"permissions": ["scripting", "storage", "alarms"],
	"host_permissions": [
		"https://claude.ai/*",
		"https://chatgpt.com/*",
		"https://gemini.google.com/*",
		"https://aistudio.google.com/*",
		"http://127.0.0.1/*"
	],
	"content_security_policy": {
		"extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:* http://127.0.0.1:*"
	}
}
