{
	"manifest_version": 3,
	"name": "AI ChatBridge Browser link",
	"version": "0.2.7",
	"description": "Lets the AI ChatBridge Obsidian plugin sync your chats through this browser, where you are logged in. Talks only to the supported sites, Gemini's picture server and 127.0.0.1.",
	"minimum_chrome_version": "116",
	"background": { "service_worker": "background.js" },
	"options_ui": { "page": "options.html", "open_in_tab": true },
	"icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
	"action": { "default_title": "AI ChatBridge Browser link", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
	"permissions": ["scripting", "storage", "alarms"],
	"externally_connectable": { "matches": ["http://127.0.0.1/*"] },
	"host_permissions": [
		"https://claude.ai/*",
		"https://chatgpt.com/*",
		"https://gemini.google.com/*",
		"https://aistudio.google.com/*",
		"https://lh3.googleusercontent.com/*",
		"http://127.0.0.1/*"
	],
	"content_security_policy": {
		"extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:* http://127.0.0.1:*"
	}
}
