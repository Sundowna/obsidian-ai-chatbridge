{
	"name": "obsidian-ai-chatbridge",
	"version": "0.25.0",
	"description": "Obsidian plugin: sync claude.ai, ChatGPT, Proton Lumo, Gemini and AI Studio chats into the vault as raw JSON plus a Markdown transcript",
	"private": true,
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test:sync": "esbuild scripts/test-chatgpt-sync.ts --bundle --platform=node --conditions=browser --format=cjs --alias:obsidian=./scripts/obsidian-test-stub.ts --log-level=warning --outfile=scripts/.test-chatgpt-sync.cjs && node scripts/.test-chatgpt-sync.cjs",
		"test:inventory": "esbuild scripts/test-chatgpt-inventory.ts --bundle --platform=node --format=cjs --log-level=warning --outfile=scripts/.test-chatgpt-inventory.cjs && node scripts/.test-chatgpt-inventory.cjs",
		"test:offline": "esbuild scripts/test-offline.ts --bundle --platform=node --format=cjs --log-level=warning --outfile=scripts/.test-offline.cjs && node scripts/.test-offline.cjs",
		"test:desktop": "esbuild scripts/test-desktop.ts --bundle --platform=node --format=cjs --alias:obsidian=./scripts/obsidian-test-stub.ts --log-level=warning --outfile=scripts/.test-desktop.cjs && node scripts/.test-desktop.cjs",
		"test:gemini": "esbuild scripts/test-gemini.ts --bundle --platform=node --format=cjs --alias:obsidian=./scripts/obsidian-test-stub.ts --log-level=warning --outfile=scripts/.test-gemini.cjs && node scripts/.test-gemini.cjs",
		"test:lumo": "esbuild scripts/test-lumo.ts --bundle --platform=browser --format=cjs --alias:obsidian=./scripts/obsidian-test-stub.ts --log-level=warning --outfile=scripts/.test-lumo.cjs && node scripts/.test-lumo.cjs"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"claude",
		"chatgpt",
		"gemini",
		"ai",
		"sync"
	],
	"author": "Sundowna",
	"license": "0BSD",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Sundowna/obsidian-ai-chatbridge.git"
	},
	"bugs": {
		"url": "https://github.com/Sundowna/obsidian-ai-chatbridge/issues"
	},
	"homepage": "https://github.com/Sundowna/obsidian-ai-chatbridge#readme",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"openpgp": "6.3.2",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	}
}
