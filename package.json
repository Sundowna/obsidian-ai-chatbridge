{
	"name": "obsidian-ai-chatbridge",
	"version": "0.54.0",
	"description": "Obsidian plugin: sync claude.ai, ChatGPT, Proton Lumo, Gemini, AI Studio and Hermes Agent chats into the vault as raw JSON plus a Markdown transcript",
	"private": true,
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"build:extension": "tsc -p extension/tsconfig.json && node extension/build.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "npm run test:offline && npm run test:ci",
		"test:ci": "npm run test:versions && npm run test:merge && npm run test:claude && npm run test:desktop && npm run test:hermes && npm run test:memory && npm run test:cloud && npm run test:codex-cloud && npm run test:gemini && npm run test:lumo && npm run test:inventory && npm run test:sync && npm run test:mobile && npm run test:remote && npm run test:computers && npm run test:handoff && npm run test:error-log && npm run test:transport && npm run test:channel && npm run test:browser-link && npm run test:bundle",
		"test:sync": "esbuild scripts/test-chatgpt-sync.ts --bundle --platform=node --conditions=browser --format=cjs --alias:obsidian=./scripts/obsidian-test-stub.ts --log-level=warning --outfile=scripts/.test-chatgpt-sync.cjs && node scripts/.test-chatgpt-sync.cjs",
		"test:inventory": "esbuild scripts/test-chatgpt-inventory.ts --bundle --platform=node --format=cjs --log-level=warning --outfile=scripts/.test-chatgpt-inventory.cjs && node scripts/.test-chatgpt-inventory.cjs",
		"test:offline": "esbuild scripts/test-offline.ts --bundle --platform=node --format=cjs --log-level=warning --outfile=scripts/.test-offline.cjs && node scripts/.test-offline.cjs",
		"test:desktop": "esbuild scripts/test-desktop.ts --bundle --platform=node --format=cjs --alias:obsidian=./scripts/obsidian-test-stub.ts --log-level=warning --outfile=scripts/.test-desktop.cjs && node scripts/.test-desktop.cjs",
		"test:gemini": "esbuild scripts/test-gemini.ts --bundle --platform=node --format=cjs --alias:obsidian=./scripts/obsidian-test-stub.ts --log-level=warning --outfile=scripts/.test-gemini.cjs && node scripts/.test-gemini.cjs",
		"test:hermes": "esbuild scripts/test-hermes.ts --bundle --platform=node --format=cjs --alias:obsidian=./scripts/obsidian-test-stub.ts --log-level=warning --outfile=scripts/.test-hermes.cjs && node scripts/.test-hermes.cjs",
		"test:memory": "esbuild scripts/test-memory.ts --bundle --platform=node --format=cjs --alias:obsidian=./scripts/obsidian-test-stub.ts --log-level=warning --outfile=scripts/.test-memory.cjs && node scripts/.test-memory.cjs",
		"test:versions": "esbuild scripts/test-versions.ts --bundle --platform=node --format=cjs --alias:obsidian=./scripts/obsidian-test-stub.ts --log-level=warning --outfile=scripts/.test-versions.cjs && node scripts/.test-versions.cjs",
		"test:claude": "esbuild scripts/test-claude-sync.ts --bundle --platform=node --format=cjs --alias:obsidian=./scripts/obsidian-test-stub.ts --log-level=warning --outfile=scripts/.test-claude-sync.cjs && node scripts/.test-claude-sync.cjs",
		"test:merge": "esbuild scripts/test-merge.ts --bundle --platform=node --format=cjs --alias:obsidian=./scripts/obsidian-test-stub.ts --log-level=warning --outfile=scripts/.test-merge.cjs && node scripts/.test-merge.cjs",
		"test:cloud": "esbuild scripts/test-cloud.ts --bundle --platform=node --format=cjs --alias:obsidian=./scripts/obsidian-test-stub.ts --log-level=warning --outfile=scripts/.test-cloud.cjs && node scripts/.test-cloud.cjs",
		"test:codex-cloud": "esbuild scripts/test-codex-cloud.ts --bundle --platform=node --format=cjs --alias:obsidian=./scripts/obsidian-test-stub.ts --log-level=warning --outfile=scripts/.test-codex-cloud.cjs && node scripts/.test-codex-cloud.cjs",
		"test:mobile": "esbuild scripts/test-mobile.ts --bundle --platform=node --format=cjs --log-level=warning --outfile=scripts/.test-mobile.cjs && node scripts/.test-mobile.cjs",
		"test:remote": "esbuild scripts/test-remote.ts --bundle --platform=node --format=cjs --alias:obsidian=./scripts/obsidian-test-stub.ts --log-level=warning --outfile=scripts/.test-remote.cjs && node scripts/.test-remote.cjs",
		"test:computers": "esbuild scripts/test-computers.ts --bundle --platform=node --format=cjs --alias:obsidian=./scripts/obsidian-test-stub.ts --log-level=warning --outfile=scripts/.test-computers.cjs && node scripts/.test-computers.cjs",
		"test:handoff": "esbuild scripts/test-handoff.ts --bundle --platform=node --format=cjs --alias:obsidian=./scripts/obsidian-test-stub.ts --log-level=warning --outfile=scripts/.test-handoff.cjs && node scripts/.test-handoff.cjs",
		"test:lumo": "esbuild scripts/test-lumo.ts --bundle --platform=browser --format=cjs --alias:obsidian=./scripts/obsidian-test-stub.ts --log-level=warning --outfile=scripts/.test-lumo.cjs && node scripts/.test-lumo.cjs",
		"test:channel": "esbuild scripts/test-channel.ts --bundle --platform=node --format=cjs --alias:obsidian=./scripts/obsidian-test-stub.ts --log-level=warning --outfile=scripts/.test-channel.cjs && node scripts/.test-channel.cjs",
		"test:browser-link": "esbuild scripts/test-browser-link.ts --bundle --platform=node --format=cjs --alias:obsidian=./scripts/obsidian-test-stub.ts --log-level=warning --outfile=scripts/.test-browser-link.cjs && node scripts/.test-browser-link.cjs",
		"test:bundle": "node scripts/test-bundle.mjs",
		"test:transport": "esbuild scripts/test-transport.ts --bundle --platform=node --format=cjs --alias:obsidian=./scripts/obsidian-test-stub.ts --log-level=warning --outfile=scripts/.test-transport.cjs && node scripts/.test-transport.cjs",
		"test:error-log": "esbuild scripts/test-error-log.ts --bundle --platform=browser --format=cjs --alias:obsidian=./scripts/obsidian-test-stub.ts --log-level=warning --outfile=scripts/.test-error-log.cjs && node scripts/.test-error-log.cjs",
		"test:extension": "npm run build:extension && esbuild scripts/test-extension.ts --bundle --platform=node --format=cjs --alias:obsidian=./scripts/obsidian-test-stub.ts --log-level=warning --outfile=scripts/.test-extension.cjs && node scripts/.test-extension.cjs",
		"live:browser-link": "esbuild scripts/live-browser-link.ts --bundle --platform=node --format=cjs --alias:obsidian=./scripts/obsidian-test-stub.ts --log-level=warning --outfile=scripts/.live-browser-link.cjs && node scripts/.live-browser-link.cjs",
		"test:extension-firefox": "npm run build:extension && esbuild scripts/test-extension-firefox.ts --bundle --platform=node --format=cjs --alias:obsidian=./scripts/obsidian-test-stub.ts --log-level=warning --outfile=scripts/.test-extension-firefox.cjs && node scripts/.test-extension-firefox.cjs"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"claude",
		"chatgpt",
		"gemini",
		"hermes",
		"ai",
		"sync"
	],
	"author": "Sundowna",
	"license": "0BSD",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Sundowna/obsidian-ai-chatbridge.git"
	},
	"bugs": {
		"url": "https://github.com/Sundowna/obsidian-ai-chatbridge/issues"
	},
	"homepage": "https://github.com/Sundowna/obsidian-ai-chatbridge#readme",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/chrome": "^0.3.8",
		"@types/node": "^22.15.17",
		"@types/ws": "^8.18.2",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"openpgp": "6.3.2",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	},
	"dependencies": {
		"ws": "^8.23.0"
	}
}
